{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "zyxel-xs1930"
  },
  "spec": {
    "title": "Zyxel XS1930-10",
    "editable": true,
    "tags": [
      "network",
      "zyxel"
    ],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Port 7 - Cisco-Switch",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "\nfrom(bucket: \"monitoring\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n    r._measurement == \"zyxel_interface\" and\n    r.source == \"192.168.10.7\" and\n    r.index == \"7\"\n  )\n\n  |> filter(fn: (r) =>\n    r._field == \"ifHighSpeed\" or\n    r._field == \"ifOperStatus\"\n  )\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: if r.ifOperStatus == 1 then int(v: r.ifHighSpeed) else 0\n  }))\n  |> last()\n"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Disconnected",
                          "color": "gray"
                        },
                        "100": {
                          "text": "100 Mbps",
                          "color": "orange"
                        },
                        "1000": {
                          "text": "1 Gbps",
                          "color": "green"
                        },
                        "2500": {
                          "text": "2.5 Gbps",
                          "color": "purple"
                        },
                        "5000": {
                          "text": "5 Gbps",
                          "color": "purple"
                        },
                        "10000": {
                          "text": "10 Gbps",
                          "color": "blue"
                        }
                      }
                    }
                  ]
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "RX / TX utilization",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "\nfrom(bucket: \"monitoring\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n    r._measurement == \"zyxel_interface\" and\n    r.source == \"192.168.10.7\" and\n    r.index == \"7\"\n  )\n\n  |> filter(fn: (r) =>\n    r._field == \"ifHCInOctets\" or\n    r._field == \"ifHCOutOctets\" or\n    r._field == \"ifHighSpeed\"\n  )\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> derivative(\n    columns: [\"ifHCInOctets\", \"ifHCOutOctets\"],\n    unit: 1s,\n    nonNegative: true\n  )\n  |> filter(fn: (r) => r.ifHighSpeed > 0)\n  |> map(fn: (r) => ({\n    _time: r._time,\n    RX: float(v: r.ifHCInOctets) * 800.0 / (float(v: r.ifHighSpeed) * 1000000.0),\n    TX: float(v: r.ifHCOutOctets) * 800.0 / (float(v: r.ifHighSpeed) * 1000000.0)\n  }))\n"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.3.1",
            "spec": {
              "options": {
                "orientation": "vertical",
                "displayMode": "gradient",
                "showUnfilled": true,
                "reduceOptions": {
                  "calcs": [
                    "mean"
                  ],
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "max": 100,
                  "decimals": 2
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "RX / TX errors",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "\nfrom(bucket: \"monitoring\")\n  |> range(start: -5m)\n  |> filter(fn: (r) =>\n    r._measurement == \"zyxel_interface\" and\n    r.source == \"192.168.10.7\" and\n    r.index == \"7\"\n  )\n\n  |> filter(fn: (r) =>\n    r._field == \"ifInErrors\" or\n    r._field == \"ifOutErrors\"\n  )\n  |> difference(nonNegative: true)\n  |> sum()\n  |> map(fn: (r) => ({\n    r with _field: if r._field == \"ifInErrors\" then \"RX\" else \"TX\"\n  }))\n  |> group()\n  |> pivot(rowKey: [\"index\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"RX\", \"TX\"])\n"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "LLDP neighbour",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb"
                      },
                      "spec": {
                        "query": "\nfrom(bucket: \"monitoring\")\n  |> range(start: -15m)\n  |> filter(fn: (r) =>\n    r._measurement == \"zyxel_lldp\" and\n    r.source == \"192.168.10.7\" and\n    r.index =~ /^[^.]+\\.7\\./\n  )\n  |> pivot(rowKey: [\"_time\", \"index\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> map(fn: (r) => ({\n    _time: r._time,\n    _value: r.remote_system_name + \" / \" + r.remote_port_id\n  }))\n  |> last()\n"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.3.1",
            "spec": {
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "textMode": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "values": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
